<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; base-uri 'none'; form-action 'none'">
<meta name="generator" content="FantasyLeagueFootball v__VERSION__">
<title>__TITLE__</title>
<style>
__CSS__
</style>
</head>
<body>

<div class="wrap">

  <header class="masthead">
    <div class="mast-l">
      <div class="eyebrow" id="eyebrow">__UPDATED__ · Board is live</div>
      <h1>__SEASON__ Draft<br> War Room</h1>
    </div>
    <div class="settings" id="settings"></div>
    <div class="livepill" id="livepill" hidden></div>
  </header>

  <section class="plan" id="plan"></section>

  <div class="controls">
    <input id="search" type="search" placeholder="Search, then Enter to cross off" aria-label="Search players; press Enter to cross off a single match">
    <div class="chips" id="chips" role="group" aria-label="Filter by position">
      <button class="chip" data-pos="ALL" aria-pressed="true">ALL</button>
      <button class="chip" data-pos="QB" aria-pressed="false">QB</button>
      <button class="chip" data-pos="RB" aria-pressed="false">RB</button>
      <button class="chip" data-pos="WR" aria-pressed="false">WR</button>
      <button class="chip" data-pos="TE" aria-pressed="false">TE</button>
      <button class="chip" data-pos="K" aria-pressed="false">K</button>
      <button class="chip" data-pos="DST" aria-pressed="false">DST</button>
    </div>
    <button class="ghost" id="liveval" type="button" aria-pressed="false">Live value</button>
    <button class="ghost" id="keeper" type="button" aria-pressed="false">Keeper info</button>
    <button class="ghost" id="print" type="button">Print sheet</button>
    <button class="ghost" id="reset">Reset board</button>
    <div class="tally" id="tally"></div>
    <div class="draftbar">
      <label class="numfield">Teams <input id="teams" type="number" min="2" max="24" inputmode="numeric"></label>
      <label class="numfield">Your slot <input id="slot" type="number" min="1" max="24" inputmode="numeric" placeholder="—"></label>
      <div class="pickinfo" id="pickinfo"></div>
      <button class="ghost" id="offboard" type="button" title="Someone not on this board was taken — keeps the pick count honest">Off-board pick</button>
    </div>
    <div class="storenote" id="storenote" hidden></div>
  </div>
  <div id="live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <div class="toast" id="toast" hidden>
    <span id="toastMsg"></span>
    <button type="button" class="toast-mine" id="toastMine" hidden>That's mine</button>
    <button type="button" class="toast-undo" id="toastUndo">Undo</button>
  </div>

  <div class="grid">
    <main id="board"></main>

    <aside class="rail">
      <section class="card hot">
        <h2>Best available</h2>
        <div class="card-body"><div class="ba" id="bestAvail"></div></div>
      </section>

      <section class="card" id="opponentcard" hidden>
        <h2>Before your next pick</h2>
        <div class="card-body tight" id="opponents"></div>
      </section>

      <section class="card" id="rostercard" hidden>
        <h2>Your roster</h2>
        <div class="card-body tight">
          <div id="roster"></div>
          <div class="needs" id="needs"></div>
          <div class="byewarn" id="byewarn" hidden></div>
          <button type="button" class="ghost rosterexport" id="exportRoster">Copy as CSV</button>
        </div>
      </section>

      <section class="card" id="dndcard">
        <h2>Do not draft</h2>
        <div class="card-body"><ul class="listing" id="dnd"></ul></div>
      </section>

      <section class="card" id="injcard">
        <h2>Injury board</h2>
        <div class="card-body tight" id="inj"></div>
      </section>

      <section class="card" id="trendcard" hidden>
        <h2>Trending adds · 24h</h2>
        <div class="card-body tight" id="trend"></div>
      </section>

      <section class="card" id="slpcard">
        <h2>Late-round targets</h2>
        <div class="card-body"><ul class="listing" id="slp"></ul></div>
      </section>
    </aside>
  </div>

  <footer>
    <div class="howto"><strong>How to use this.</strong> Click any player to cross them off as they're taken — the board saves itself, so a refresh won't lose your draft. Best available and the tier-break warnings update as you go. When a tier drops to two players left, that's your cue to reach rather than wait for the turn.</div>
    <div id="provenance"></div>
    <div id="adpnote"></div>
    <div class="srcs" id="srcs"></div>
    <div>FantasyLeagueFootball v__VERSION__</div>
  </footer>
</div>

<script>
const DATA = __DATA__;
</script>
<script>
__JS__
</script>
</body>
</html>
